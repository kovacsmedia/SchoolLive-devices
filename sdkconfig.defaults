# SchoolLive ESP32-S3 N16R8 — mixed Arduino + ESP-IDF (v5.5.x)
#
# Csak a tényleg szükséges Kconfig override-ok. A többi default jó a
# pioarduino platformon, vagy az Arduino-ESP32 v3.x maga állítja be.

# Az Arduino-ESP32 v3.x is megköveteli a 1000 Hz-es FreeRTOS tick-et.
CONFIG_FREERTOS_HZ=1000

# Az Arduino komponens biztosítsa az app_main()-t és indítsa el automatikusan
# a setup() / loop() ciklust. E nélkül a linker undefined reference-szel hibázik.
CONFIG_AUTOSTART_ARDUINO=y

# Octal (OPI) PSRAM az N16R8 modulokhoz, 80 MHz órajellel.
# ESP-IDF v5.x-en a generikus CONFIG_SPIRAM a target-független név.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# ── Belső DRAM tehermentesítése (2026-09-10) ────────────────────────────────
# Az S3-on a belső DRAM ~320 kB, a mért mélypont 61 kB volt. A PSRAM 8 MB,
# tehát a szűk keresztmetszet KIZÁRÓLAG a belső RAM.
#
# ALWAYSINTERNAL: ekkora méret ALATT minden malloc a belső DRAM-ba megy.
# A 16 kB-os alapérték gyakorlatilag MINDENT bent tartott (a legtöbb foglalás
# ennél kisebb). 4 kB-ra levivé a nagyobb pufferek (TLS, HTTP, WS, fájl-I/O)
# átkerülnek a PSRAM-ba. A DMA-t igénylő foglalások NEM érintettek: azok
# explicit MALLOC_CAP_DMA / MALLOC_CAP_INTERNAL kéréssel jönnek, és azt a
# heap allokátor tiszteletben tartja.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# RESERVE_INTERNAL: ennyi belső DRAM-ot tartunk fenn azoknak, amiknek MUSZÁJ
# belülre kerülniük (DMA-pufferek, ISR-ből elért adat, task-stackek). Ha a
# belső szabad terület e alá csökkenne, az általános malloc a PSRAM-ba tér ki
# ahelyett, hogy felélné a maradékot. 32 → 64 kB, mert épp az volt a baj, hogy
# a mélypont 61 kB-ig ment le.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# Flash méret: 16 MB. Csak N16R8 modulokat használunk az éles eszközökön.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# WiFiClientSecure pre-shared-key ciphersuite-okat igényel.
# Enélkül az ssl_client.cpp belső implementáció nem fordul be a binarybe.
# A WS kapcsolat wss://, azaz TARTÓSAN nyitott TLS session. Enélkül a
# 16 kB-os bejövő és a 4 kB-os kimenő rekord-puffer VÉGIG foglalva marad a
# belső DRAM-ban, a HTTP-hívások alatt pedig egy második session is felépül.
# A dynamic buffer a rekordok között felszabadítja őket, és csak a tényleges
# rekordmérethez foglal – tipikusan 20-30 kB belső DRAM-ot ad vissza.
#
# HA A TLS BÁRMIÉRT HIBÁZNA (kézfogás-hiba, "mbedtls" logok), EZ AZ EGY SOR
# az első, amit érdemes visszavenni – a többi memória-optimalizálás független tőle.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

CONFIG_MBEDTLS_PSK_MODES=y
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK=y
CONFIG_MBEDTLS_KEY_EXCHANGE_DHE_PSK=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_PSK=y
CONFIG_MBEDTLS_KEY_EXCHANGE_RSA_PSK=y

# I2S driver conflict check kikapcsolása. ESP-IDF v5.x runtime-ban abort-ot
# dob, ha a legacy driver/i2s.h ÉS a new driver/i2s_std.h ugyanabban a
# binarában van. A mi rendszerünkben CSAK a legacy-t használjuk (SnapcastClientESP32
# és ESP32-audioI2S), de az Arduino-ESP32 v3.x ESP_I2S lib weak link-eli az új
# drivert, ami triggereli az ellenőrzést.
# A futási konfliktus NINCS - senki nem hívja az új API-t. A Fázis 2-3 után
# (új snap kliens + libhelix MP3) ez a flag eltávolítható.
CONFIG_I2S_SKIP_LEGACY_CONFLICT_CHECK=y

# Snapcast volume-fix:
# A snap stream PCM mintáin a dsp_processor SOFT_VOL mechanizmusa végzi
# a hangerő-skálázást. Ez kell, mert:
#  - a MAX98357A passzív erősítő, hardveres volume nincs;
#  - a snap szerver oldali volume kezelést szándékosan kihagyjuk
#    (server_settings_msg_received force-olja volume=100, muted=false-ra,
#    így a backend mute targeting nem zavarja össze a player_task indulását);
#  - a kliens manuális (1-10) hangerejét tehát kizárólag PCM-szinten
#    érvényesítjük, a dsp_processor_set_volome()-on át.
# E két flag nélkül a Snapcast stream MINDIG max hangerőn szól.
CONFIG_USE_DSP_PROCESSOR=y
CONFIG_SNAPCLIENT_USE_SOFT_VOL=y

# ── Task Watchdog: elsüléskor INDÍTSON ÚJRA ────────────────────────────────
# Eddig `CONFIG_ESP_TASK_WDT_PANIC` NÉLKÜL futott, azaz a watchdog elsülésekor
# CSAK NAPLÓZOTT – a beragadt eszköz beragadva maradt, és a csengetés
# határozatlan ideig elmaradt. Egy felügyelet nélküli csengetőrendszernél ez
# elfogadhatatlan: inkább induljon újra 10 másodperc alatt.
#
# A timeout 5 → 10 mp: a flash-műveletek (OTA-írás, LittleFS hangletöltés)
# másodpercekre leköthetik a magot, és nem akarunk téves újraindulásokat.
#
# FIGYELEM: ez CSAK a kiéheztetett idle taskot veszi észre (pörgő, nem
# yieldelő kód). A blokkolva beragadt szálakat — mutex, socket — nem látja,
# mert az idle task olyankor fut. Azokra a main.cpp kereszt-szívverése való.
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# WPA2 Enterprise (EAP-PEAP/MSCHAPv2) támogatás az eduroam-szerű hálózatokhoz.
# A SLNetworkManager::connectEnterprise() használja az esp_eap_client.h API-t.
# Plus a server cert validáció kikapcsolva (disable_time_check=true), mert a
# provisioning UI-ból "CA tanúsítvány nem szükséges" beállítást kapunk.
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=y
