# SchoolLive ESP32-S3 (N16R8 / N8R8) — mixed Arduino + ESP-IDF
#
# Itt csak azokat a Kconfig értékeket állítjuk explicit-re, amiket
# a board JSON nem örökít át mixed módban. A többi default jó.

# Az Arduino-ESP32 megköveteli a 1000 Hz-es FreeRTOS tick-et.
# E nélkül a CMake config errorral leáll.
CONFIG_FREERTOS_HZ=1000

# Az Arduino komponens biztosítsa az app_main()-t és indítsa el automatikusan
# a setup() / loop() ciklust. E nélkül a linker undefined reference-szel hibázik.
CONFIG_AUTOSTART_ARDUINO=y

# Octal (OPI) PSRAM az N16R8 / N8R8 modulokhoz, 80 MHz órajellel.
# ESP-IDF v4.4-en a target-specifikus flag aktivál: ESP32-S3-on
# CONFIG_ESP32S3_SPIRAM_SUPPORT, NEM a generikus CONFIG_SPIRAM.
# E nélkül a PSRAM nem inicializálódik, és csak a 320 KB SRAM heap
# áll rendelkezésre — a snap PCM jitter buffer azt percek alatt kifutja.
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# Flash méret: 16 MB. Csak N16R8 modulokat használunk az éles eszközökön.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# WiFiClientSecure pre-shared-key ciphersuite-okat igényel.
# Enélkül az ssl_client.cpp belső implementáció nem fordul be a binarybe,
# és a linker `start_ssl_client` / `ssl_init` / stb. undefined-ot dob.
CONFIG_MBEDTLS_PSK_MODES=y
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK=y
CONFIG_MBEDTLS_KEY_EXCHANGE_DHE_PSK=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_PSK=y
CONFIG_MBEDTLS_KEY_EXCHANGE_RSA_PSK=y
